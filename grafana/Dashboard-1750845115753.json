          "query": "alarms = from(bucket: \"ProgettoIot\")\r\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\r\n  |> filter(fn: (r) => r._measurement == \"temperature_alarms\")\r\n  |> map(fn: (r) => ({ r with _value: 1 }))\r\n  |> aggregateWindow(every: 30s, fn: sum, createEmpty: false)\r\n  |> keep(columns: [\"_time\", \"_value\"])\r\n\r\ntemperature = from(bucket: \"ProgettoIot\")\r\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\r\n  |> filter(fn: (r) => \r\n    r._measurement == \"temperature\" and\r\n    r._field == \"value\" and\r\n    r.location == \"indoor\"\r\n  )\r\n  |> aggregateWindow(every: 30s, fn: mean, createEmpty: false)\r\n  |> keep(columns: [\"_time\", \"_value\"])\r\n\r\njoin(\r\n  tables: {t: temperature, a: alarms},\r\n  on: [\"_time\"]\r\n)\r\n|> map(fn: (r) => ({\r\n  _time: r._time,\r\n  _value: if r._value_a > 0 then r._value_t else float(v: 0),\r\n  _field: \"value\",\r\n  _measurement: \"temperature\"\r\n}))\r\n|> yield(name: \"Temperatura con allarme\")\r\n",
